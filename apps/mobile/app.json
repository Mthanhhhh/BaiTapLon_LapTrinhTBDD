{
  "expo": {
    "name": "E-Shop",
    "slug": "eshop-tbdd",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "vn.io.mtcord.eshop",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-asset",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép E-Shop truy cập ảnh để đăng sản phẩm lên shop.",
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "eshop",
    "owner": "mthanh",
    "extra": {
      "eas": {
        "projectId": "5e32b975-5db9-4c80-ae84-2c726df8335a"
      }
    }
  }
}
