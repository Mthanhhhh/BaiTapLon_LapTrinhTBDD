        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(application) (rate(http_server_requests_seconds_count{application=~\"$service\",instance=~\"$instance\",uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "{{application}} {{instance}} {{kind}}"
